# ====== DATABASE ======
DATABASE_URL=mysql://sarkari:password@localhost:3306/sarkariscout
DB_ROOT_PASSWORD=mysql_root_password_here
DB_PASSWORD=sarkari_app_password_here

# ====== REDIS ======
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change_this_redis_password

# ====== JWT ======
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ====== SERVER ======
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# ====== TIMEZONE ======
TZ=Asia/Kolkata

# ====== EMAIL (Mailtrap dev) ======
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass

# ====== EMAIL (Brevo prod) ======
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@sarkariscout.in

# ====== ADS ======
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXX

# ====== RATE LIMITING ======
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
