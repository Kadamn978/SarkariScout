# Backend Environment Variables — per environment
# Copy to .env and fill in values
# NEVER commit .env files — they contain secrets

# ─── Database ────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://:password@host:6379

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=minimum-32-characters-long-secret-here

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# ─── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RozgarScout <noreply@rozgarscout.in>
SMTP_SECURE=false

# ─── Google OAuth ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─── Frontend URL (for email links) ─────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Cookie Domain ───────────────────────────────────────
# Leave empty for localhost, set to domain in production
COOKIE_DOMAIN=

# ─── Error Tracking (production only, skipped in dev) ────
SENTRY_DSN=

# ─── Encryption key for sensitive data (32 hex chars) ────
ENCRYPTION_KEY=

# ─── Feature Flags ───────────────────────────────────────
# Set to false to disable PDF download/storage (saves MySQL disk)
ENABLE_PDF_STORAGE=true

# Set to true on first deploy to seed admin user + sources (no sample jobs)
SEED_DB=false

# ─── Timezone ────────────────────────────────────────────
TZ=Asia/Kolkata
