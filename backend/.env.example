# ====== DATABASE ======
DATABASE_URL=mysql://root:password@localhost:3306/sarkariscout

# ====== REDIS ======
REDIS_URL=redis://localhost:6379

# ====== JWT ======
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ====== SERVER ======
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://sarkariscout.in,https://www.sarkariscout.in

# ====== EMAIL (Mailtrap dev) ======
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass

# ====== EMAIL (Brevo prod) ======
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@sarkariscout.in

# ====== ADS ======
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXX

# ====== RATE LIMITING ======
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
