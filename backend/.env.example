# ====== DATABASE ======
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sarkariradar?schema=public

# ====== REDIS ======
REDIS_URL=redis://localhost:6379

# ====== JWT ======
JWT_SECRET=change-this-to-a-random-secret-in-production

# ====== SERVER ======
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173

# ====== EMAIL (Mailtrap dev) ======
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_PASS=your_mailtrap_pass

# ====== EMAIL (Brevo prod) ======
BREVO_API_KEY=your_brevo_api_key
BREVO_sender_EMAIL=noreply@yourdomain.app

# ====== NCS API (free) ======
NCS_API_KEY=your_ncs_api_key
NCS_API_URL=https://api.ncs.gov.in

# ====== ENCRYPTION ======
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key
