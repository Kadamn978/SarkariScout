generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  GEN
  OBC
  SC
  ST
  EWS
}

enum JobStatus {
  OPEN
  CLOSED
  REVIEW
}

enum TrackerStage {
  APPLIED
  EXAM
  ADMIT_CARD
  RESULT
  REJECTED
  SELECTED
}

enum NotificationType {
  DIGEST
  INSTANT
  WELCOME
}

enum ChangeType {
  EXAM_DATE
  VENUE
  DEADLINE
  CORRIGENDUM
  RESULT
  ADMIT_CARD
}

enum SourceType {
  NCS_API
  RSS
  HTML
  PDF
}

enum JobCategory {
  GOVERNMENT
  SEMI_GOVERNMENT
  PSU
  BANKING
  RAILWAY
  DEFENCE
  POLICE
  TEACHING
  MEDICAL
  ENGINEERING
  IT
  PRIVATE
  INTERNSHIP
  TRAINING
  CONTRACT
}

enum DocumentType {
  PHOTO
  SIGNATURE
  MARKSHEET
  CERTIFICATE
  ID_PROOF
  ADDRESS_PROOF
  CATEGORY_CERT
  EXPERIENCE
  OTHER
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String?
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile       Profile?
  trackers      UserJob[]
  notifications NotificationLog[]
  subscriptions Subscription[]
  documents     UserDocument[]
  bugReports    BugReport[]

  @@map("users")
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationLevel String?
  degrees        String?   @db.Text
  state          String?
  district       String?
  languages      String?   @db.Text
  category       Category?
  dob            DateTime?
  gender         String?
  examFamilies   String?   @db.Text
  keywords       String?   @db.Text
  notifyInstant  Boolean   @default(true)
  notifyDigest   Boolean   @default(true)
  digestTime     String    @default("09:00")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("profiles")
}

model Source {
  id            String     @id @default(uuid())
  name          String
  type          SourceType
  baseUrl       String
  schedule      String     @default("*/6 * * * *")
  lastRunAt     DateTime?
  lastRunStatus String?
  itemsPerRun   Int        @default(0)
  enabled       Boolean    @default(true)
  configJson    String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  jobs Job[]

  @@map("sources")
}

model Job {
  id                  String    @id @default(uuid())
  fingerprint         String    @unique
  sourceId            String?
  source              Source?   @relation(fields: [sourceId], references: [id])
  sourceUrl           String?
  org                 String
  advtNo              String?
  title               String
  postNames           String?   @db.Text
  totalVacancies      Int?
  state               String    @default("ALL_IN")
  category            JobCategory @default(GOVERNMENT)
  examFamily          String?
  qualificationText   String?   @db.Text
  qualificationLevels String?   @db.Text
  ageMin              Int?
  ageMax              Int?
  categoryFeesJson    String?   @db.Text
  applyStart          DateTime?
  applyEnd            DateTime?
  feeEnd              DateTime?
  examDate            DateTime?
  admitCardDate       DateTime?
  resultDate          DateTime?
  status              JobStatus @default(OPEN)
  notificationPdfUrl  String?
  applyUrl            String?
  officialUrls        String?   @db.Text
  rawHash             String?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  changes       JobChange[]
  trackers      UserJob[]
  notifications NotificationLog[]

  @@index([status])
  @@index([rawHash])
  @@index([sourceId])
  @@index([state])
  @@index([applyEnd])
  @@index([category])
  @@map("jobs")
}

model JobChange {
  id         String     @id @default(uuid())
  jobId      String
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type       ChangeType
  field      String
  before     String?    @db.Text
  after      String?    @db.Text
  detectedAt DateTime   @default(now())
  notified   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([jobId])
  @@index([detectedAt])
  @@map("job_changes")
}

model UserJob {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applied   Boolean       @default(false)
  appliedAt DateTime?
  notes     String?       @db.Text
  stage     TrackerStage?
  examCity  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, jobId])
  @@map("user_jobs")
}

model NotificationLog {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String?
  job    Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type   NotificationType
  sentAt DateTime         @default(now())
  status String           @default("sent")

  @@index([userId])
  @@index([jobId])
  @@index([sentAt])
  @@map("notification_logs")
}

model Subscription {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String    @default("FREE")
  status          String    @default("active")
  razorpayOrderId String?
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.Text
  method    String?  @db.VarChar(10)
  url       String?  @db.Text
  status    Int?
  duration  Int?
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model ErrorLog {
  id        String   @id @default(uuid())
  level     String   @default("error")
  message   String   @db.Text
  stack     String?  @db.Text
  method    String?  @db.VarChar(10)
  url       String?  @db.VarChar(500)
  status    Int?
  userId    String?
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.Text
  causedBy  String?  @db.Text
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@index([userId])
  @@map("error_logs")
}

model UserDocument {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        DocumentType
  name        String
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  isDefault   Boolean      @default(false)
  metadata    String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([type])
  @@map("user_documents")
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  description String   @db.Text
  category    String   @default("bug")
  priority    String   @default("medium")
  status      BugStatus @default(OPEN)
  adminNotes  String?  @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("bug_reports")
}

model MockTest {
  id              String   @id @default(uuid())
  title           String
  description     String?  @db.Text
  examFamily      String
  qualification   String?
  totalQuestions  Int
  totalMarks      Int
  durationMinutes Int
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions MockQuestion[]
  attempts  MockTestAttempt[]

  @@index([examFamily])
  @@index([isPublished])
  @@map("mock_tests")
}

model MockQuestion {
  id            String   @id @default(uuid())
  testId        String
  test          MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText  String   @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  explanation   String?  @db.Text
  marks         Int      @default(1)
  sortOrder     Int      @default(0)

  @@index([testId])
  @@map("mock_questions")
}

model MockTestAttempt {
  id            String    @id @default(uuid())
  testId        String
  test          MockTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId        String
  score         Int?
  totalAnswered Int?
  correctCount  Int?
  timeTakenSec  Int?
  answers       String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([testId])
  @@index([userId])
  @@index([createdAt])
  @@map("mock_test_attempts")
}

model PreviousPaper {
  id            String   @id @default(uuid())
  title         String
  examFamily    String
  year          Int
  qualification String?
  fileUrl       String?
  externalUrl   String?
  description   String?  @db.Text
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([examFamily])
  @@index([year])
  @@map("previous_papers")
}
