generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  GEN
  OBC
  SC
  ST
  EWS
}

enum JobStatus {
  OPEN
  CLOSED
  REVIEW
}

enum TrackerStage {
  APPLIED
  EXAM
  ADMIT_CARD
  RESULT
  REJECTED
  SELECTED
}

enum NotificationType {
  DIGEST
  INSTANT
  WELCOME
  CHANGE_ALERT
  VERIFICATION
  PASSWORD_RESET
}

enum ChangeType {
  EXAM_DATE
  VENUE
  DEADLINE
  CORRIGENDUM
  RESULT
  ADMIT_CARD
}

enum SourceType {
  NCS_API
  RSS
  HTML
  PDF
}

enum JobCategory {
  GOVERNMENT
  SEMI_GOVERNMENT
  PSU
  BANKING
  RAILWAY
  DEFENCE
  POLICE
  TEACHING
  MEDICAL
  ENGINEERING
  IT
  PRIVATE
  INTERNSHIP
  TRAINING
  CONTRACT
}

enum DocumentType {
  PHOTO
  SIGNATURE
  MARKSHEET
  CERTIFICATE
  ID_PROOF
  ADDRESS_PROOF
  CATEGORY_CERT
  EXPERIENCE
  OTHER
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String?
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile         Profile?
  trackers        UserJob[]
  notifications   NotificationLog[]
  subscriptions   Subscription[]
  documents       UserDocument[]
  bugReports      BugReport[]
  emailPreference EmailPreference?
  mockAttempts    MockTestAttempt[]

  @@map("users")
}

model Profile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationLevel   String?
  degrees          String?   @db.Text
  state            String?
  district         String?
  languages        String?   @db.Text
  category         Category?
  dob              DateTime?
  gender           String?
  phone            String?
  examFamilies     String?   @db.Text
  preferredStates  String?   @db.Text
  preferredPosts   String?   @db.Text
  keywords         String?   @db.Text
  experience       String?   @db.Text
  notifyInstant    Boolean   @default(true)
  notifyDigest     Boolean   @default(true)
  digestTime       String    @default("09:05")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("profiles")
}

model Source {
  id              String     @id @default(uuid())
  name            String
  type            SourceType
  baseUrl         String
  schedule        String     @default("0 */6 * * *")
  lastRunAt       DateTime?
  lastRunStatus   String?
  lastRunMessage  String?
  itemsPerRun     Int        @default(0)
  totalItems      Int        @default(0)
  enabled         Boolean    @default(true)
  configJson      String?    @db.Text
  selectorsJson   String?    @db.Text
  headersJson     String?    @db.Text
  rateLimitMs     Int        @default(1000)
  retryCount      Int        @default(3)
  errorMessage    String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  jobs      Job[]
  crawlLogs CrawlLog[]

  @@map("sources")
}

model Job {
  id                      String    @id @default(uuid())
  fingerprint             String    @unique
  sourceId                String?
  source                  Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceUrl               String?
  org                     String
  advtNo                  String?
  title                   String
  postNames               String?   @db.Text
  totalVacancies          Int?
  state                   String    @default("ALL_IN")
  district                String?
  category                JobCategory @default(GOVERNMENT)
  examFamily              String?
  qualificationText       String?   @db.Text
  qualificationLevels     String?   @db.Text
  ageMin                  Int?
  ageMax                  Int?
  gender                  String?   @default("ALL")
  categoryFeesJson        String?   @db.Text
  generalFee              Int?
  obcFee                  Int?
  scStFee                 Int?
  applyStart              DateTime?
  applyEnd                DateTime?
  feeEnd                  DateTime?
  feePaymentEnd           DateTime?
  examDate                DateTime?
  examEndDate             DateTime?
  admitCardDate           DateTime?
  resultDate              DateTime?
  interviewDate           DateTime?
  status                  JobStatus @default(OPEN)
  notificationPdfUrl      String?
  applyUrl                String?
  applyUrlPost            String?
  officialNotificationUrl String?
  officialUrls            String?   @db.Text
  eligibilityCriteria     String?   @db.Text
  howToApply              String?   @db.Text
  selectionProcess        String?   @db.Text
  examPattern             String?   @db.Text
  syllabus                String?   @db.Text
  importantDates          String?   @db.Text
  contactInfo             String?   @db.Text
  sourceUrlHash           String?
  rawHtml                 String?   @db.Text
  rawHash                 String?
  firstSeenAt             DateTime  @default(now())
  lastSeenAt              DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  changes       JobChange[]
  trackers      UserJob[]
  notifications NotificationLog[]

  @@index([status])
  @@index([rawHash])
  @@index([sourceId])
  @@index([state])
  @@index([district])
  @@index([applyEnd])
  @@index([category])
  @@index([examFamily])
  @@index([feePaymentEnd])
  @@index([sourceId, createdAt])
  @@index([status, applyEnd])
  @@index([category, status])
  @@index([status, state, applyEnd])
  @@index([status, category, applyEnd])
  @@index([status, examFamily])
  @@map("jobs")
}

model JobChange {
  id         String     @id @default(uuid())
  jobId      String
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type       ChangeType
  field      String
  before     String?    @db.Text
  after      String?    @db.Text
  detectedAt DateTime   @default(now())
  notified   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([jobId])
  @@index([detectedAt])
  @@index([notified, detectedAt])
  @@map("job_changes")
}

model UserJob {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applied   Boolean       @default(false)
  appliedAt DateTime?
  notes     String?       @db.Text
  stage     TrackerStage?
  examCity  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([stage])
  @@index([userId, stage])
  @@map("user_jobs")
}

model NotificationLog {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type      NotificationType
  channel   String           @default("email")
  subject   String?
  sentAt    DateTime         @default(now())
  status    String           @default("sent")
  openedAt  DateTime?
  clickedAt DateTime?
  bounced   Boolean          @default(false)
  unsubscribed Boolean       @default(false)

  @@index([userId])
  @@index([jobId])
  @@index([sentAt])
  @@index([type])
  @@index([userId, sentAt])
  @@index([userId, type, sentAt])
  @@map("notification_logs")
}

model EmailPreference {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  digestEnabled  Boolean   @default(true)
  digestTime     String    @default("09:05")
  instantEnabled Boolean   @default(false)
  weeklyEnabled  Boolean   @default(true)
  unsubscribeToken String @unique @default(uuid())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("email_preferences")
}

model CrawlLog {
  id          String   @id @default(uuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status      String   @default("running")
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  itemsFound  Int      @default(0)
  itemsNew    Int      @default(0)
  itemsUpdated Int     @default(0)
  errorMessage String? @db.Text
  duration    Int?

  @@index([sourceId])
  @@index([startedAt])
  @@index([status])
  @@map("crawl_logs")
}

model Subscription {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String    @default("FREE")
  status          String    @default("active")
  razorpayOrderId String?
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.Text
  method    String?  @db.VarChar(10)
  url       String?  @db.Text
  status    Int?
  duration  Int?
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model ErrorLog {
  id        String   @id @default(uuid())
  level     String   @default("error")
  message   String   @db.Text
  stack     String?  @db.Text
  method    String?  @db.VarChar(10)
  url       String?  @db.VarChar(500)
  status    Int?
  userId    String?
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.Text
  causedBy  String?  @db.Text
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@index([userId])
  @@map("error_logs")
}

model UserDocument {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        DocumentType
  name        String
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  isDefault   Boolean      @default(false)
  metadata    String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([type])
  @@map("user_documents")
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  description String   @db.Text
  category    String   @default("bug")
  priority    String   @default("medium")
  status      BugStatus @default(OPEN)
  adminNotes  String?  @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("bug_reports")
}

model MockTest {
  id              String   @id @default(uuid())
  title           String
  description     String?  @db.Text
  examFamily      String
  qualification   String?
  totalQuestions  Int
  totalMarks      Int
  durationMinutes Int
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions MockQuestion[]
  attempts  MockTestAttempt[]

  @@index([examFamily])
  @@index([isPublished])
  @@map("mock_tests")
}

model MockQuestion {
  id            String   @id @default(uuid())
  testId        String
  test          MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionText  String   @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  explanation   String?  @db.Text
  marks         Int      @default(1)
  sortOrder     Int      @default(0)

  @@index([testId])
  @@map("mock_questions")
}

model MockTestAttempt {
  id            String    @id @default(uuid())
  testId        String
  test          MockTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score         Int?
  totalAnswered Int?
  correctCount  Int?
  timeTakenSec  Int?
  answers       String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([testId])
  @@index([userId])
  @@index([createdAt])
  @@map("mock_test_attempts")
}

model PreviousPaper {
  id            String   @id @default(uuid())
  title         String
  examFamily    String
  year          Int
  qualification String?
  fileUrl       String?
  externalUrl   String?
  description   String?  @db.Text
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([examFamily])
  @@index([year])
  @@map("previous_papers")
}

model PageView {
  id          String   @id @default(uuid())
  path        String
  visitorId   String
  userAgent   String?
  referrer    String?
  country     String?
  city        String?
  device      String?
  browser     String?
  os          String?
  isUnique    Boolean  @default(false)
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([path])
  @@index([visitorId])
  @@index([createdAt])
  @@index([path, createdAt])
  @@map("page_views")
}

model DailyStats {
  id              String   @id @default(uuid())
  date            DateTime @unique
  totalViews      Int      @default(0)
  uniqueVisitors  Int      @default(0)
  pageViews       Json?
  topPages        Json?
  referrers       Json?
  devices         Json?
  browsers        Json?
  newVsReturning  Json?
  createdAt       DateTime @default(now())

  @@index([date])
  @@map("daily_stats")
}
