# === PRODUCTION ENV — NEVER LOAD IN DEV ===
# Usage: Set these in Railway dashboard (Variables tab)
# NEVER commit real values — this is a template only

DATABASE_URL=CHANGE_THIS_IN_PROD
REDIS_URL=CHANGE_THIS_IN_PROD
JWT_SECRET=CHANGE_THIS_IN_PROD_use_openssl_rand_hex_64
PORT=3000
NODE_ENV=production
TZ=Asia/Kolkata

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=https://rozgarscout.in,https://www.rozgarscout.in

# Frontend URL (for email links and OAuth redirect)
FRONTEND_URL=https://rozgarscout.in

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_THIS_GMAIL
SMTP_PASS=CHANGE_THIS_GMAIL_APP_PASSWORD
SMTP_FROM=RozgarScout <noreply@rozgarscout.in>
SMTP_SECURE=false

# Security
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_HEX

# Google OAuth — create at console.cloud.google.com
# Add callback URL to authorized redirect URIs
GOOGLE_CLIENT_ID=CHANGE_THIS
GOOGLE_CLIENT_SECRET=CHANGE_THIS
GOOGLE_CALLBACK_URL=https://rozgarscout.in/api/auth/google/callback

# Sentry (production only — skipped when empty)
SENTRY_DSN=CHANGE_THIS

# Cookie domain — leave empty if frontend/backend on different domains
COOKIE_DOMAIN=

# Feature flags
ENABLE_PDF_STORAGE=false
SEED_DB=false
